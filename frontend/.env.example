# Copy this file to frontend/.env and fill in the value. NEVER commit frontend/.env.
# Optional: without a key the app still works, and documents are added by pasting an IPFS link.

# Pinata key that can ONLY upload (pinFileToIPFS on, Admin off).
# Anyone who opens a build made with this key can read it, so never use the full
# PINATA_JWT from the root .env here. Restart `npm run dev` after changing it.
VITE_PINATA_UPLOAD_JWT=
