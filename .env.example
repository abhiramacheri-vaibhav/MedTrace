# Copy this file to .env and fill in the values. NEVER commit .env.
# Lines like `KEY=   # comment` are read as empty values, so this file works unedited.

# --- Deployment (Polygon Amoy testnet) ---
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
PRIVATE_KEY=            # deployer wallet private key, 64 hex chars (use a test-only wallet)
ETHERSCAN_API_KEY=      # optional, for source verification; one etherscan.io key works for Amoy (Etherscan API V2)
POLYGONSCAN_API_KEY=    # legacy fallback, only used if ETHERSCAN_API_KEY is empty (must also be an etherscan.io key)

# --- Off-chain scripts ---
RPC_URL=http://127.0.0.1:8545   # or the Amoy RPC above
CONTRACT_ADDRESS=               # printed by scripts/deploy.js (also in deployments/<network>.json)
SENSOR_PRIVATE_KEY=             # wallet with SENSOR_ROLE
PINATA_JWT=                     # IPFS pinning (Interim Demo)
